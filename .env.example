
DATABASE_URL=
BETTER_AUTH_URL=
# public address of the app, for canonical links, the sitemap and emails (defaults to https://zadaci.vercel.app)
VITE_SITE_URL=
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend, for invite and notification emails; leave empty to skip sending
RESEND_API_KEY=

# Web push notifications. Make a pair with `npx web-push generate-vapid-keys`; leave empty to turn push off
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Bearer token for the hourly reminders and digest job (/api/cron/daily) and the internal
# AI model status page (/api/ai/models). Any long random string
CRON_SECRET=

# Unsplash photos for note covers and images (https://unsplash.com/developers); optional
UNSPLASH_ACCESS_KEY=

# AI assistant (OpenRouter). The shared key, used on the server only; get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Encrypts people's own AI keys (Claude, ChatGPT, Gemini, OpenRouter) before they're stored. Keep it
# out of the database and never change it once keys are saved, or they can't be read. Make one with
# `openssl rand -base64 48`
AI_KEYS_SECRET=
# pin one model and turn rotation off (empty = rotate through ranked free models)
AI_MODEL=
# comma separated model id fragments to try first, e.g. "nemotron,gemma"
AI_MODEL_PREFERRED=
# test models with one real tool call before ranking them (uses free daily quota)
AI_ROTATION_PROBE=false
# free messages a day for people without their own AI key (default 2)
AI_DAILY_LIMIT=
# public address sent to OpenRouter as HTTP-Referer (defaults to the site address)
APP_URL=

# Live updates (Supabase Realtime): everyone's open pages refresh when anything changes, with no
# reload. Supabase → Project Settings → API: the project URL and the anon public key. Leave empty to
# turn live updates off (pages still refresh when you open them).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Private Realtime channels (only members can listen). Turn on once Supabase trusts Zadaci's
# tokens (Authentication > Third-Party Auth > Custom OIDC, issuer = BETTER_AUTH_URL) and
# Realtime's "Allow public access" is off. The secret key stays on the server.
REALTIME_PRIVATE=
SUPABASE_SECRET_KEY=
# Local only, with REALTIME_PRIVATE on: the deployed site's address (the issuer Supabase trusts),
# so live updates and who's online work from localhost too. Leave empty in production.
AUTH_JWT_ISSUER=
